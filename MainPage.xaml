<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CarnetDepenses.ViewModels"
             x:Class="CarnetDepenses.MainPage">
    <ContentPage.Resources>
        <vm:InverseBoolConverter x:Key="InverseBool" />
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="16" RowSpacing="10">
        <VerticalStackLayout Spacing="8">
            <Entry Placeholder="Libelle" Text="{Binding Libelle}" />
            <Entry Placeholder="Montant" Text="{Binding MontantTexte}" Keyboard="Numeric" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="{Binding TexteBoutonAjout}" Command="{Binding AjouterCommand}" />
                <Button Text="Annuler" Command="{Binding AnnulerCommand}"
                        IsVisible="{Binding EstEnEdition}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Label FontSize="18" FontAttributes="Bold"
                   Text="{Binding Total, StringFormat='Total : {0:N0} FCFA'}" />
            <Entry Placeholder="Budget mensuel (FCFA)" Text="{Binding BudgetTexte}" Keyboard="Numeric" />
            <ProgressBar Progress="{Binding ProgressionBudget}" />
            <Label Text="{Binding TexteBudget}" TextColor="Red"
                   IsVisible="{Binding BudgetDepasse}" />
            <Label Text="{Binding TexteBudget}"
                   IsVisible="{Binding BudgetDepasse, Converter={StaticResource InverseBool}}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Depenses}"
                        SelectedItem="{Binding Selection, Mode=TwoWay}"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label Text="{Binding Libelle}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Montant}" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="X"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DepensesViewModel}}, Path=SupprimerCommand}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout Grid.Row="3" Spacing="6">
            <Button Text="Convertir le total en EUR" Command="{Binding ConvertirCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding TotalConverti}" FontSize="16" />
            <Label Text="{Binding Message}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

